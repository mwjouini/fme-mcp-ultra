# ==============================================================================
# FME-MCP-ULTRA ENVIRONMENT CONFIGURATION (British English)
# ==============================================================================

# Server Configuration
FME_MCP_HOST=0.0.0.0
FME_MCP_PORT=8000
FME_MCP_TRANSPORT=stdio
FME_MCP_LOG_LEVEL=INFO
FME_MCP_ENVIRONMENT=production

# Security & Authentication
FME_MCP_AUTH_MODE=api_key
FME_MCP_API_KEY=change-me-to-a-secure-random-token-in-production
FME_MCP_OAUTH_CLIENT_ID=
FME_MCP_OAUTH_CLIENT_SECRET=
FME_MCP_OAUTH_TOKEN_URL=
FME_MCP_ENCRYPTION_KEY=

# File System Security & Sandboxing (PathGuard)
# Semicolon or comma-separated list of authorised base paths
FME_ALLOWED_DIRS=E:\fme_mcp;C:\Users\mjouini\Documents;C:\Program Files\FME

# Network Security (SSRF Guard)
# Comma-separated list of allowed remote hostnames/domains for federation
FME_ALLOWED_OUTBOUND_DOMAINS=fme-flow.internal,safe.com,api.github.com

# FME Form (Local Desktop) Settings
FME_FORM_ENABLED=true
FME_DIR=C:\Program Files\FME
FME_TIMEOUT_SECONDS=600

# FME Flow (Remote Enterprise Cluster) Settings
FME_FLOW_ENABLED=false
FME_FLOW_URL=https://fme-flow.your-organisation.com
FME_FLOW_TOKEN=your-fme-flow-api-token
FME_FLOW_VERIFY_SSL=true

# Observability
FME_MCP_TELEMETRY_ENABLED=true
FME_MCP_PROMETHEUS_METRICS=true

